{
  "_comment": "探星安全配置（§5）—— 启动时由 zod schema 严格校验（见 src/core/config-schemas.ts）",
  "rate_limits": {
    "douyin": {
      "search_calls_per_hour": 10,
      "user_videos_calls_per_hour": 30,
      "friend_request_per_day": 5,
      "dm_per_day": 10
    },
    "min_interval_seconds": 3,
    "max_interval_seconds": 8
  },
  "daily_budget": {
    "videos": 50,
    "comments_scanned": 5000,
    "leads_created": 200,
    "engagement_actions": 20
  },
  "emergency_stop": "config/EMERGENCY_STOP",
  "fatal_signals": [
    "auth_wall_detected",
    "captcha_triggered_3_times_in_1h",
    "private_msg_rejected_2_times",
    "ip_changed_5_times"
  ],
  "hook_review": {
    "enabled": true,
    "review_before_execute": true,
    "auto_apply_after_weeks": 2
  },
  "browser": {
    "_comment": "真实浏览器配置（puppeteer-core + 用户 Chrome Profile）。Chrome 路径自动检测，可用 CHROME_EXECUTABLE_PATH 环境变量覆盖",
    "user_data_dir": "~/Library/Application Support/Google/Chrome/探星Profile",
    "headless": false,
    "_user_data_dir_note": "用户首次使用时需在 Chrome 中登录抖音（V1.4 设计：'探星Profile' 独立 Profile）"
  }
}
